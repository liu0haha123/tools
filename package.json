{
  "name": "everyday-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "eslint currency-converter scripts tests eslint.config.js",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --experimental-vm-modules --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  }
}
